# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/voice_conversion
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# --- Voice sample storage (Phase 2) ---
# STORAGE_BACKEND=local switches STORAGE_LOCAL_ROOT to store files on disk;
# STORAGE_BACKEND=s3 requires STORAGE_S3_BUCKET (and optionally
# STORAGE_S3_ENDPOINT_URL for S3-compatible services like MinIO).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT_URL=

# --- Voice sample validation limits (Phase 2) ---
MIN_SAMPLE_DURATION_SECONDS=3
MAX_SAMPLE_DURATION_SECONDS=60
MAX_SAMPLE_FILE_SIZE_MB=25
MIN_VALID_VOICE_SAMPLES=3

# Frontend: base URL the browser uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
